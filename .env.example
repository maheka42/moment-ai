# Gnani Speech APIs
# Keep your real API key in the local .env file only. Never commit it.
GNANI_BASE_URL=https://api.vachana.ai
GNANI_API_KEY_ID=
# Prisma v3.0 short-clip REST contract shared for this project.
GNANI_STT_ENDPOINT=https://api.vachana.ai/stt/v3
GNANI_PRISMA_MODEL=prisma-v3.0
# Set GNANI_PRISMA_MODEL= to omit the model field and use the account's default model.
# Public Batch STT docs currently specify gnani-prisma-v2.5.
GNANI_BATCH_STT_MODEL=gnani-prisma-v2.5
# Timbre v2.5 REST returns binary audio.
GNANI_TTS_ENDPOINT=https://api.vachana.ai/api/v1/tts/inference

# Hosted OpenAI-compatible LLM API (Groq recommended for this build).
# Keep the provider API key in your local .env file only. Never commit it.
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
MAX_UPLOAD_MB=50
CORS_ORIGINS=http://localhost:5173
