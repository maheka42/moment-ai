# Gnani Speech APIs
# Keep your real API key in the local .env file only. Never commit it.
GNANI_BASE_URL=https://api.vachana.ai
GNANI_API_KEY_ID=
GNANI_STT_ENDPOINT=
GNANI_TTS_ENDPOINT=

# Evon is open-weight; configure only after selecting a supported inference runtime.
GNANI_LLM_ENDPOINT=

MAX_UPLOAD_MB=50
CORS_ORIGINS=http://localhost:5173
